# ============================================================================
# এই ফাইলটার নাম হবে ঠিক  .env  (শুধু .env, .env.example না)
# প্রোজেক্টের একদম রুট ফোল্ডারে (package.json যেখানে আছে, ঠিক সেখানে) রাখবেন।
# এই ফাইল কখনো GitHub-এ commit করবেন না — .gitignore এমনিতেই আটকাবে।
# নিচের প্রতিটা "=" এর পরে ফাঁকা জায়গায় আপনার আসল key/value বসান।
# ============================================================================

# --- Alchemy ---
# কোথা থেকে পাবেন: https://dashboard.alchemy.com → নতুন App বানান → "API Key" কপি করুন
VITE_ALCHEMY_API_KEY=alch_NhKEi-ICXC5cch2V8aHeF

# এটা বদলানোর দরকার নেই, এটা ঠিক আছে
VITE_ALCHEMY_NETWORK_SUBDOMAIN=robinhood-mainnet


# --- OpenSea ---
# কোথা থেকে পাবেন: https://docs.opensea.io/reference/api-keys → "Request an API key" ফর্ম পূরণ করুন
VITE_OPENSEA_API_KEY=A2pPGdHihu_Ghv4iL8Uzm6HxPpN_JUZ8oxAG6KsOs7pVKqAmD8lsaJeaGDg0HOlXPEG8FIP2-mGI9N4KgUHnTWFBnSP0uTw

# এটা বদলানোর দরকার নেই, এটা ঠিক আছে
VITE_OPENSEA_CHAIN_SLUG=robinhood


# --- WalletConnect ---
# কোথা থেকে পাবেন: https://cloud.walletconnect.com → লগইন/সাইনআপ করুন → "Create Project" → Project ID কপি করুন
VITE_WALLETCONNECT_PROJECT_ID=f4362b1ea4735c7f157bbe07a65b3df2


# --- Chain (এগুলো বদলানোর দরকার নেই, আগে থেকেই ঠিক আছে) ---
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com


# --- Collection contract address (এটাও ঠিক আছে, বদলানোর দরকার নেই) ---
VITE_COLLECTION_ADDRESS=0x68e5a6aaf2503940f0337243063ab8f4da6bedec
